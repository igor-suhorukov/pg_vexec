#
# gp_ao's batch source (pg19/modules/gp_ao/ao_batch.c): tables of its own
# beside %t, made by the first line: %t_g, every type class in blocks of
# 8 kB, three segment files, columns added after the rows by each way
# ALTER TABLE adds them, whole blocks deleted; %t_n, blocks of 16,384
# rows; %t_v, deleted from and vacuumed.  rle_type, zlib, zstd and none.
SET client_min_messages = warning; DO $d$ BEGIN IF to_regtype('gp_ao_flag') IS NULL THEN CREATE DOMAIN gp_ao_flag AS bool; CREATE DOMAIN gp_ao_pos AS int CHECK (VALUE >= 0); CREATE TYPE gp_ao_mood AS ENUM ('sad', 'ok', 'happy'); END IF; END $d$; CREATE OR REPLACE FUNCTION gp_ao_nest(tab text, sel text, g int, at int, lo int, hi int, depth int) RETURNS bool LANGUAGE plpgsql AS $f$ BEGIN IF g = at THEN IF depth > 1 THEN EXECUTE format('INSERT INTO %I SELECT %s FROM generate_series(%s, %s) g WHERE gp_ao_nest(%L, %L, g, %s, %s, %s, %s)', tab, sel, lo, hi, tab, sel, lo + 1000, hi + 1, hi + 4000, depth - 1); ELSE EXECUTE format('INSERT INTO %I SELECT %s FROM generate_series(%s, %s) g', tab, sel, lo, hi); END IF; END IF; RETURN true; END $f$; CREATE OR REPLACE FUNCTION gp_ao_explain(q text) RETURNS SETOF text LANGUAGE plpgsql AS $f$ BEGIN RETURN QUERY EXECUTE 'EXPLAIN (VERBOSE, COSTS OFF) ' || q; END $f$; CREATE OR REPLACE FUNCTION gp_ao_make(base text) RETURNS text LANGUAGE plpgsql AS $f$ DECLARE am text; tg text := base || '_g'; tn text := base || '_n'; tv text := base || '_v'; sel text := 'g, CASE WHEN (g / 1500) % 3 = 1 THEN NULL ELSE g::int8 * 7 END, CASE WHEN g % 11 = 0 THEN NULL ELSE (g % 30000 - 15000)::int2 END, CASE WHEN g % 5 = 0 THEN NULL ELSE g % 3 = 0 END, (g % 4 = 0)::gp_ao_flag, (g / 7.0)::float4, ((g % 10000) / 3.0)::numeric(9,2), g * 1.25, CASE WHEN g % 9 = 0 THEN NULL WHEN g % 3 = 0 THEN repeat(chr(97 + g % 26), 120 + g % 90) ELSE ''t'' || g END, (g % 1000)::text::char(5), decode(md5(g::text), ''hex''), DATE ''2000-01-01'' + g % 20000, TIMESTAMP ''2000-01-01'' + g * interval ''17 minutes'', TIMESTAMPTZ ''2000-01-01 00:00:00+00'' + g * interval ''3 hours'', g * interval ''1 minute'' + (g % 40) * interval ''1 month'', TIMETZ ''00:00:00+02'' + g * interval ''1 second'', md5(g::text)::uuid, (''name'' || g % 777)::name, (g % 120)::"char", (g % 100000)::money, (''08:00:2b:01:02:'' || lpad(to_hex(g % 256), 2, ''0''))::macaddr, point(g, g / 2.0), ARRAY[g % 3, g % 5, g], jsonb_build_object(''g'', g % 17, ''s'', ''v'' || g % 5), (ARRAY[''sad'', ''ok'', ''happy''])[1 + g % 3]::gp_ao_mood, (g % 1000)::gp_ao_pos'; defs text; BEGIN SELECT a.amname INTO am FROM pg_class c JOIN pg_am a ON a.oid = c.relam WHERE c.oid = base::regclass; IF to_regclass(tg) IS NOT NULL THEN RETURN am; END IF; SELECT string_agg(c || CASE WHEN am = 'ao_column' THEN ' ENCODING (compresstype=' || e || ')' ELSE '' END, ', ' ORDER BY i) INTO defs FROM unnest(ARRAY['id int', 'i8 int8', 'i2 int2', 'b bool', 'db gp_ao_flag', 'f4 float4', 'n numeric(9,2)', 'nf numeric', 't text', 'bp char(5)', 'by bytea', 'd date', 'ts timestamp', 'tz timestamptz', 'iv interval', 'tt timetz', 'u uuid', 'nm name', 'ch "char"', 'mo money', 'ma macaddr', 'pt point', 'arr int[]', 'j jsonb', 'e gp_ao_mood', 'dom gp_ao_pos'], ARRAY['rle_type', 'zstd', 'zlib', 'rle_type', 'none', 'none', 'zlib', 'zstd', 'zstd', 'zlib', 'none', 'rle_type', 'rle_type', 'rle_type', 'zlib', 'zstd', 'none', 'zlib', 'rle_type', 'none', 'zlib', 'zstd', 'zlib', 'zstd', 'none', 'rle_type']) WITH ORDINALITY AS x(c, e, i); EXECUTE format('CREATE TABLE %I (%s) %s', tg, defs, CASE am WHEN 'ao_column' THEN 'USING ao_column WITH (blocksize=8192, checksum=true)' WHEN 'ao_row' THEN 'USING ao_row WITH (blocksize=8192, compresstype=zstd, compresslevel=3, checksum=true)' ELSE 'USING heap' END); EXECUTE format('INSERT INTO %I SELECT %s FROM generate_series(1, 20000) g WHERE gp_ao_nest(%L, %L, g, 5000, 20001, 26000, 2)', tg, sel, tg, sel); EXECUTE format('ALTER TABLE %I ADD COLUMN vd float8 DEFAULT random()', tg); EXECUTE format('ALTER TABLE %I ADD COLUMN fd int DEFAULT 7', tg); EXECUTE format('ALTER TABLE %I ADD COLUMN nd text', tg); EXECUTE format('ALTER TABLE %I ADD COLUMN ft text DEFAULT repeat(''m'', 20)', tg); sel := sel || ', g % 2 - 0.5, g % 3, ''late '' || g, CASE WHEN g % 2 = 0 THEN repeat(''n'', g % 30) END'; EXECUTE format('INSERT INTO %I SELECT %s FROM generate_series(40001, 43000) g WHERE gp_ao_nest(%L, %L, g, 41000, 43001, 45000, 1)', tg, sel, tg, sel); EXECUTE format('DELETE FROM %I WHERE id BETWEEN 7001 AND 9500 OR id BETWEEN 22001 AND 23500 OR id %% 13 = 0 OR id BETWEEN 41500 AND 42499', tg); EXECUTE format('CREATE TABLE %I (id int, b bool, s int2, c "char") %s', tn, CASE am WHEN 'ao_column' THEN 'USING ao_column WITH (blocksize=2097152, compresstype=rle_type)' WHEN 'ao_row' THEN 'USING ao_row WITH (blocksize=2097152, compresstype=none, checksum=true)' ELSE 'USING heap' END); EXECUTE format('INSERT INTO %I SELECT g, g %% 3 = 0, CASE WHEN g %% 1000 = 999 THEN NULL ELSE (g %% 5000)::int2 END, (g %% 100)::"char" FROM generate_series(1, 100000) g', tn); EXECUTE format('DELETE FROM %I WHERE id BETWEEN 40001 AND 60000 OR id %% 1000 = 7', tn); EXECUTE format('CREATE TABLE %I (id int, t text, x int8) %s', tv, CASE am WHEN 'ao_column' THEN 'USING ao_column WITH (blocksize=8192, compresstype=zlib)' WHEN 'ao_row' THEN 'USING ao_row WITH (blocksize=8192, compresstype=zlib)' ELSE 'USING heap' END); EXECUTE format('INSERT INTO %I SELECT g, CASE WHEN g %% 4 = 0 THEN NULL ELSE ''v'' || g END, g * 3 FROM generate_series(1, 20000) g', tv); EXECUTE format('DELETE FROM %I WHERE id %% 10 < 3 OR id BETWEEN 15001 AND 17000', tv); RETURN am; END $f$; SELECT gp_ao_make('%t') IS NOT NULL; SELECT count(*), count(DISTINCT id) FROM %t_g
SET vexec.mode = force; SELECT string_agg(l, ' ') FROM (SELECT gp_ao_explain('SELECT * FROM %t_g') l UNION ALL SELECT gp_ao_explain('SELECT * FROM %t_n') UNION ALL SELECT gp_ao_explain('SELECT * FROM %t_v')) s WHERE l LIKE '%Source:%'
SELECT count(*), count(i8), count(i2), count(b), count(t), count(vd), count(fd), count(nd), count(ft), sum(length(ft)), sum(i8), sum(i2), sum(f4), sum(n), sum(nf), sum(fd), sum(dom) FROM %t_g
SELECT md5(string_agg(concat_ws(',', id, i8, i2, b, db, f4, n, nf, t, bp, by, d, ts, tz, iv, tt, u, nm, ch, mo, ma, pt, arr, j, e, dom, vd, fd, nd, ft), '|' ORDER BY id)) FROM %t_g
SELECT md5(string_agg(concat_ws(',', id, i8, i2, b, db, f4, n, nf, t, bp, by, d, ts, tz, iv, tt, u, nm, ch, mo, ma, pt, arr, j, e, dom, vd, fd, nd, ft), '|' ORDER BY id)) FROM %t_g WHERE id % 7 IN (1, 4)
SELECT count(*) FROM %t_g
SELECT count(ctid), count(*) FROM %t_g WHERE ctid IS NOT NULL
SELECT id, ctid FROM %t_g WHERE id % 991 = 0 OR id IN (1, 5000, 20000, 20001, 21001, 26000, 26001, 30000, 40001, 41000, 43000, 43001, 45000) ORDER BY id
SELECT count(*) FILTER (WHERE i8 IS NULL), count(*) FILTER (WHERE b), count(*) FILTER (WHERE db), count(*) FILTER (WHERE nd IS NULL), count(*) FILTER (WHERE fd = 7), count(*) FILTER (WHERE vd < 0.5) FROM %t_g
SELECT r FROM %t_g r WHERE id IN (1, 2, 3, 5001, 9501, 20001, 26001, 40002, 41001, 43001) ORDER BY id
SELECT a, (SELECT count(*) FROM %t_g WHERE id % 5 = a AND b) FROM generate_series(0, 4) a ORDER BY a
SELECT sum(id), count(*), md5(string_agg(t, ',')) FROM (SELECT id, t FROM %t_g LIMIT 2500) s
SET gp.select_invisible = on; SELECT count(*), sum(id) FROM %t_g
SELECT count(*), sum(length(t)), max(t), min(bp), max(nm), sum(length(by)), max(nd), max(ft), min(ft) FROM %t_g WHERE t > 'm' OR nd IS NOT NULL OR ft < 'n'
SELECT d, count(*), max(tz) FROM %t_g WHERE ts < '2000-03-01' GROUP BY d ORDER BY d LIMIT 20
SELECT iv, tt, pt, ma, mo, e, dom, ch, arr, j FROM %t_g WHERE id % 3001 = 0 ORDER BY id
SELECT count(*), max(u::text), max(j::text), max(iv), min(tt) FROM %t_g WHERE nf > 100 AND n < 1000 AND f4 > 3 AND i2 IS NOT NULL
SELECT count(*), sum(id) FROM generate_series(1, 3) a, LATERAL (SELECT id FROM %t_g WHERE id % 1000 = a LIMIT 7) s
SELECT count(*), sum(id), count(*) FILTER (WHERE b), sum(s), count(s), max(c) FROM %t_n
SELECT sum(id), count(*) FROM (SELECT id FROM %t_n LIMIT 70000) s
SELECT id, ctid, s, b FROM %t_n WHERE id % 9973 = 0 ORDER BY id
SELECT count(*), count(ctid) FROM %t_n WHERE b AND s IS NULL
BEGIN; DECLARE gp_ao_c CURSOR FOR SELECT id, s FROM %t_n WHERE id % 7 = 0; FETCH 3 FROM gp_ao_c; FETCH 5000 FROM gp_ao_c; FETCH 2 FROM gp_ao_c; COMMIT
BEGIN; INSERT INTO %t_n SELECT g, g % 2 = 0, NULL, 'q' FROM generate_series(200001, 200700) g; DELETE FROM %t_n WHERE id <= 300 OR id % 997 = 0; UPDATE %t_n SET s = -1 WHERE id % 1001 = 0; SELECT count(*), sum(id), count(s), sum(s), count(*) FILTER (WHERE s = -1), max(ctid::text) IS NOT NULL FROM %t_n; ROLLBACK
BEGIN; SAVEPOINT a; INSERT INTO %t_n SELECT g, true, 7, 'r' FROM generate_series(300001, 300400) g; ROLLBACK TO a; INSERT INTO %t_n SELECT g, false, 8, 's' FROM generate_series(400001, 400050) g; SELECT count(*), sum(id), sum(s) FROM %t_n; ROLLBACK
SELECT count(*), sum(x), md5(string_agg(t, ',' ORDER BY id)) FROM %t_v
VACUUM %t_v
INSERT INTO %t_v SELECT g, 'w' || g, g FROM generate_series(30001, 30500) g WHERE NOT EXISTS (SELECT 1 FROM %t_v WHERE id = 30001)
SELECT count(*), count(t), sum(x), md5(string_agg(t, ',' ORDER BY id)) FROM %t_v
SELECT id, ctid, t FROM %t_v WHERE id % 1999 = 0 OR id IN (30001, 30500) ORDER BY id
