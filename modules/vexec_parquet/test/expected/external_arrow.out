-- the same rows in three files: other codecs, another order of columns
CREATE TABLE arrow_parts (:columns) USING vexec_parquet WITH (location = :'parts');
SELECT count(*) AS differ FROM ((TABLE arrow_all EXCEPT ALL TABLE arrow_parts)
	UNION ALL (TABLE arrow_parts EXCEPT ALL TABLE arrow_all)) x;
 differ 
--------
      0
(1 row)

-- through vexec's source, in both formats
SET vexec.mode = force;
SELECT count(*) AS differ FROM ((TABLE arrow_all EXCEPT ALL TABLE arrow_parts)
	UNION ALL (TABLE arrow_parts EXCEPT ALL TABLE arrow_all)) x;
 differ 
--------
      0
(1 row)

SELECT count(*), sum(u32), sum(f16), min(ts_ns), max(dec38), count(DISTINCT dict) FROM arrow_parts;
 count |      sum      |  sum   |           min            |               max                | count 
-------+---------------+--------+--------------------------+----------------------------------+-------
  1000 | 1712000000000 | 107000 | Wed Jan 01 12:00:00 2020 | 123333332223333332334.3333332000 |     5
(1 row)

EXPLAIN (ANALYZE, COSTS OFF, TIMING OFF, SUMMARY OFF, BUFFERS OFF)
	SELECT count(*), sum(i32) FROM arrow_all WHERE id BETWEEN 600 AND 610;
                         QUERY PLAN                          
-------------------------------------------------------------
 Vec Aggregate (actual rows=1.00 loops=1)
   ->  Vec Seq Scan on arrow_all (actual rows=11.00 loops=1)
         Filter: ((id >= 600) AND (id <= 610))
         Rows Removed by Filter: 239
(4 rows)

SELECT count(*), sum(i32) FROM arrow_all WHERE id BETWEEN 600 AND 610;
 count |    sum     
-------+------------
    11 | 6050018150
(1 row)

EXPLAIN (VERBOSE, COSTS OFF) SELECT count(*), min(id), max(ts_us) FROM arrow_all;
                  QUERY PLAN                   
-----------------------------------------------
 Vec Aggregate
   Output: (count(*)), (min(id)), (max(ts_us))
   Batch Format: postgres
   Vector Transitions: 3 of 3
   Transitions: count(*), min, max
   Kernel Steps: 0
   Fallback Steps: 0
   Input: batches
   From Statistics: vexec_parquet
   ->  Vec Seq Scan on public.arrow_all
         Output: id, ts_us
         Batch Format: postgres
         Kernel Steps: 0
         Fallback Steps: 0
         Source: vexec_parquet
(15 rows)

SELECT count(*), min(id), max(ts_us) FROM arrow_all;
 count | min |               max               
-------+-----+---------------------------------
  1000 |   0 | Wed Jan 01 12:16:39.000999 2020
