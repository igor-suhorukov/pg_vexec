-- Tables that read the files of another writer, pyarrow's
-- (test/data/make_files.py, written into VPQ_TEST_DATA before the test)
\getenv data VPQ_TEST_DATA
SELECT :'data' || '/all.parquet' AS all_file, :'data' || '/part-*.parquet' AS parts,
	:'data' || '/nested.parquet' AS nested, :'data' || '/paged.parquet' AS paged \gset
-- the columns as a table would declare them
SELECT name, type, nullable, arrow_type FROM vexec_parquet.columns(:'all_file');
 name  |       type       | nullable |                     arrow_type                      
-------+------------------+----------+-----------------------------------------------------
 id    | bigint           | t        | int64
 i8    | smallint         | t        | int8
 i16   | smallint         | t        | int16
 i32   | integer          | t        | int32
 u8    | smallint         | t        | uint8
 u16   | integer          | t        | uint16
 u32   | bigint           | t        | uint32
 u64   | numeric(20,0)    | t        | uint64
 f16   | real             | t        | halffloat
 f32   | real             | t        | float
 f64   | double precision | t        | double
 b     | boolean          | t        | bool
 s     | text             | t        | string
 ls    | text             | t        | large_string
 bin   | bytea            | t        | binary
 dict  | text             | t        | dictionary<values=string, indices=int32, ordered=0>
 d32   | date             | t        | date32[day]
 d64   | date             | t        | date32[day]
 ts_s  | timestamp        | t        | timestamp[ms]
 ts_ms | timestamp        | t        | timestamp[ms]
 ts_us | timestamp        | t        | timestamp[us]
 ts_ns | timestamp        | t        | timestamp[ns]
 tz_us | timestamptz      | t        | timestamp[us, tz=UTC]
 t32   | time             | t        | time32[ms]
 t64   | time             | t        | time64[ns]
 dec9  | numeric(9,2)     | t        | decimal128(9, 2)
 dec18 | numeric(18,4)    | t        | decimal128(18, 4)
 dec38 | numeric(38,10)   | t        | decimal128(38, 10)
 uu    | bytea            | t        | fixed_size_binary[16]
 nul   |                  | t        | null
(30 rows)

SELECT vexec_parquet.column_list(:'all_file') AS columns \gset
CREATE TABLE arrow_all (:columns) USING vexec_parquet WITH (location = :'all_file');
SELECT count(*) FROM arrow_all;
 count 
-------
  1000
(1 row)

