(1 row)

-- two columns of the table, neither a constant
SELECT vexec_check('SELECT a.id, a.embedding <-> b.embedding FROM items a JOIN items b ON b.id = a.id + 1 WHERE a.id % 97 = 0');
                  vexec_check                  
-----------------------------------------------
