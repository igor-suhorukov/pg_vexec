(1 row)

SELECT vexec_check(format('SELECT id, halfvec_l2_squared_distance(half, %L), halfvec_negative_inner_product(half, %L), halfvec_spherical_distance(half, %L) FROM items WHERE id %% 23 = 0', h16, h16, h16)) FROM q;
                  vexec_check                   
------------------------------------------------
