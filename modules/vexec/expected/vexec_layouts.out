(5 rows)

-- and with the per-structure settings changed one at a time, and with
-- every column dictionary-encoded
SELECT v.varlena, b.bool, t.temporal, n.numeric, d.dict,
       count(*) AS columns, sum(e.nulls) AS nulls, min(e.rows) AS rows
FROM (VALUES ('format'), ('datum'), ('view'), ('offsets')) v(varlena),
     (VALUES ('format'), ('byte'), ('bit')) b(bool),
     (VALUES ('format'), ('postgres'), ('arrow')) t(temporal),
     (VALUES ('format'), ('scaled'), ('varlena')) n(numeric),
     (VALUES (false), (true)) d(dict),
     LATERAL vexec_test.export('SELECT * FROM corpus ORDER BY id', 'arrow',
                               v.varlena, b.bool, t.temporal, n.numeric, d.dict) e
WHERE (v.varlena = 'format')::int + (b.bool = 'format')::int +
      (t.temporal = 'format')::int + (n.numeric = 'format')::int >= 3
GROUP BY 1, 2, 3, 4, 5 ORDER BY 1, 2, 3, 4, 5;
 varlena |  bool  | temporal | numeric | dict | columns | nulls | rows 
---------+--------+----------+---------+------+---------+-------+------
 datum   | format | format   | format  | f    |      39 | 16311 | 2600
 datum   | format | format   | format  | t    |      39 | 16311 | 2600
 format  | bit    | format   | format  | f    |      39 | 16311 | 2600
 format  | bit    | format   | format  | t    |      39 | 16311 | 2600
 format  | byte   | format   | format  | f    |      39 | 16311 | 2600
 format  | byte   | format   | format  | t    |      39 | 16311 | 2600
 format  | format | arrow    | format  | f    |      39 | 16311 | 2600
 format  | format | arrow    | format  | t    |      39 | 16311 | 2600
 format  | format | format   | format  | f    |      39 | 16311 | 2600
 format  | format | format   | format  | t    |      39 | 16311 | 2600
 format  | format | format   | scaled  | f    |      39 | 16311 | 2600
 format  | format | format   | scaled  | t    |      39 | 16311 | 2600
 format  | format | format   | varlena | f    |      39 | 16311 | 2600
 format  | format | format   | varlena | t    |      39 | 16311 | 2600
 format  | format | postgres | format  | f    |      39 | 16311 | 2600
 format  | format | postgres | format  | t    |      39 | 16311 | 2600
 offsets | format | format   | format  | f    |      39 | 16311 | 2600
 offsets | format | format   | format  | t    |      39 | 16311 | 2600
 view    | format | format   | format  | f    |      39 | 16311 | 2600
