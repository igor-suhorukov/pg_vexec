 1 |                                                                                           NaN |                                                                                       NaN
 2 |                                                                                      Infinity |                                                                                  Infinity
 3 | 12345678901234567890123456789012345678901234575353.123456788999999999999999999999999999999999 | 9852896170179224174080971100568512114047274202.197225424412609736632083000798084596967279
(4 rows)

-- constant arguments: one value for every row
SELECT agg_check($$SELECT max('a'::text COLLATE "C"), min(42), sum(1.5), count(NULL::int),
       bool_or(true) FILTER (WHERE id > 5) FROM at$$);
  agg_check   
