(1 row)

SELECT agg_check($$SELECT x, count(*) FROM (VALUES (0.0::float8), (-0.0), ('NaN'), ('NaN'),
       ('Infinity'), ('-Infinity'), (NULL), (0.0)) v(x) GROUP BY x$$);
  agg_check   
--------------
