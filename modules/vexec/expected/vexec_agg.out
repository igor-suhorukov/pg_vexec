CREATE FUNCTION agg_runs() RETURNS SETOF text LANGUAGE sql AS $f$
SELECT agg_check('SELECT u, count(*) FROM ar GROUP BY u')
UNION ALL
SELECT agg_check('SELECT u, count(*), sum(x), avg(y), min(x), max(y), count(s) FROM ar GROUP BY u')
UNION ALL
SELECT agg_check('SELECT b, count(*), sum(y) FROM ar GROUP BY b')
UNION ALL
SELECT agg_check('SELECT h, count(*), sum(y) FROM ar GROUP BY h')
UNION ALL
SELECT agg_check('SELECT u, s, count(*), min(x) FROM ar GROUP BY u, s')
UNION ALL
SELECT agg_check('SELECT s, count(*), max(x) FROM ar GROUP BY s')
UNION ALL
SELECT agg_check('SELECT l, count(*), max(x) FROM ar GROUP BY l')
UNION ALL
SELECT agg_check('SELECT l, s, b, count(*) FROM ar GROUP BY l, s, b')
UNION ALL
SELECT agg_check('SELECT extract(minute FROM ts), u, count(*), sum(y) FROM ar GROUP BY 1, 2')
UNION ALL
SELECT agg_check('SELECT u, count(*), sum(x) FROM ar WHERE x % 3 <> 0 GROUP BY u')
UNION ALL
SELECT agg_check('SELECT s, l, count(*) FROM ar WHERE x % 3 <> 0 GROUP BY s, l')
UNION ALL
SELECT agg_check('SELECT count(*), min(c), max(c) FROM (SELECT u, count(*) AS c FROM ar WHERE u BETWEEN 1 AND 1000 GROUP BY u LIMIT 7) q')
UNION ALL
SELECT agg_check('SELECT count(*), min(c), max(c), sum(z) > 0 FROM (SELECT l, count(*) AS c, sum(x) AS z FROM ar WHERE x BETWEEN 16 AND 16015 GROUP BY l LIMIT 7) q')
$f$;
