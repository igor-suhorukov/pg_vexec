(1 row)

-- money has no hash operator class: PostgreSQL's sorted aggregation
SELECT agg_check('SELECT m, count(*) FROM at GROUP BY m');
    agg_check    
-----------------
 same, no VecAgg
(1 row)

SELECT agg_check('SELECT f, r, count(*) FROM at GROUP BY f, r');
  agg_check   
--------------
