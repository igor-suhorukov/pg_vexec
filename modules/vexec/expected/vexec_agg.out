(1 row)

SET client_min_messages = warning;
CREATE EXTENSION IF NOT EXISTS vexec_test;
RESET client_min_messages;
SELECT count(*) AS keys, count(*) FILTER (WHERE r = 'none') AS none,
       count(*) FILTER (WHERE r NOT IN ('ok', 'none')) AS differ
FROM (SELECT vexec_test.scaled_key(round(v, s), s, o) AS r
      FROM generate_series(0, 18) s,
           (VALUES (0::numeric), (1), (-1), (5), (9999), (10000), (100000000), (123456789.123456789),
                   (-0.0001), (0.5), (12.25), (99999999.99999), (1e-18), (9.223372036854775807),
                   (9223372036854775807), (-9223372036854775808), (1234567890123.4567)) x(v),
           LATERAL (VALUES (round(v, s)), (round(v, s) * 1.000), (round(v, s) + 1), (-round(v, s)),
                           (round(v, s) + 0.000000000000000001), (0), ('NaN'), ('Infinity')) y(o)) z;
 keys | none | differ 
------+------+--------
 2584 |  736 |      0
(1 row)

-- F14 (§3.32): Q18's shape -- extract()'s minute and another key, nearly
-- every row a group of its own -- in parallel, the first stage frozen and
-- its rows bypassed, each a group packed with its key's scaled integer, the
-- final stage's groups so too, C3's ten projected; a key of scale 6
SET parallel_setup_cost = 0;
SET parallel_tuple_cost = 0;
SET min_parallel_table_scan_size = 0;
SET max_parallel_workers_per_gather = 2;
SET vexec.partial_agg_limit = 100;
SELECT agg_check($$SELECT id % 7000, extract(minute FROM ts), count(*) FROM af GROUP BY 1, 2
       ORDER BY 3 DESC, 1, 2 LIMIT 10$$);
  agg_check   
--------------
 same, VecAgg
(1 row)

SELECT agg_check($$SELECT extract(second FROM ts), count(*), sum(id) FROM af GROUP BY 1$$);
  agg_check   
--------------
 same, VecAgg
(1 row)

SELECT agg_check($$SELECT extract(minute FROM ts) AS m, count(*) FROM af GROUP BY 1 HAVING count(*) > 400$$);
  agg_check   
--------------
 same, VecAgg
(1 row)

RESET vexec.partial_agg_limit;
RESET parallel_setup_cost;
RESET parallel_tuple_cost;
RESET min_parallel_table_scan_size;
RESET max_parallel_workers_per_gather;
DROP TABLE af;
-- explain mode: costed, recorded, never built
SET vexec.mode = explain;
EXPLAIN (COSTS OFF) SELECT k, count(*) FROM at GROUP BY k;
      QUERY PLAN      
----------------------
 HashAggregate
   Group Key: k
   ->  Seq Scan on at
(3 rows)

