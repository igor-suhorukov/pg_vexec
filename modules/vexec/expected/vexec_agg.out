-- F29 (§3.38): the final stage's sub-buffers hold references to the packed
-- groups where the exchange keeps them -- its chunks, which it gives back
-- once the groups are out -- a file's records copied; a group of keys and
-- states by value, where its run first meets it, the packed group itself --
-- every query above so, by default; off, F23's copies.  The counts the
-- leader's, alone here: integer and text keys' groups the records, a text
-- minimum's groups made; in windows past the memory; the chunks in files
CREATE FUNCTION agg_figure(q text, label text) RETURNS bigint LANGUAGE plpgsql AS $$
DECLARE
	r record;
	v bigint := 0;
BEGIN
	PERFORM set_config('vexec.mode', 'force', true);
	FOR r IN EXECUTE 'EXPLAIN (ANALYZE, VERBOSE, COSTS OFF, TIMING OFF, SUMMARY OFF, BUFFERS OFF) ' || q LOOP
		IF r."QUERY PLAN" ~ ('^ *' || label || ': ') THEN
			v := v + substring(r."QUERY PLAN" FROM ': ([0-9]+)')::bigint;
		END IF;
	END LOOP;
	RETURN v;
END $$;
SET vexec.enable_final_references = off;
