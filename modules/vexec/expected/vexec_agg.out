SELECT q, agg_figure(q, 'Records Referenced') > 0 AS referenced,
       agg_figure(q, 'Records Made Groups') > 0 AS made_groups,
       agg_figure(q, 'Chunks Kept for References') > 0 AS kept
  FROM (VALUES ('SELECT k, count(*), sum(id), avg((id % 1000)::int2), sum(id::int8), min(id), bool_or(id > 9) FROM ap GROUP BY k'),
               ('SELECT k, d, count(*), max(id) FROM ap GROUP BY k, d'),
               ('SELECT t, count(*), sum(id) FROM ap GROUP BY t'),
               ('SELECT k % 3000, count(*), min(t), max(id) FROM ap GROUP BY 1')) v(q);
