               Bound: 5
               ->  Vec Finalize HashAggregate
                     Group Key: ((k % 100))
                     ->  Parallel Vec Repartition
                           Partition Key: ((k % 100))
                           ->  Vec Combine HashAggregate
                                 Group Key: ((k % 100))
                                 ->  Vec Combine HashAggregate
                                       Group Key: ((k % 100)), t
                                       ->  Parallel Vec Repartition
                                             Partition Key: ((k % 100)), t
                                             ->  Vec Partial HashAggregate
                                                   Group Key: ((k % 100)), t
                                                   ->  Parallel Vec Seq Scan on ah
(19 rows)

