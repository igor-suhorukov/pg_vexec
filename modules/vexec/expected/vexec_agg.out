-- F31 (§3.38): a batch whose rows are of one key -- its key columns' values
-- the first row's, by their bits, bytes or dictionary codes, NULLs alike --
-- takes its group once and its transitions as a plain aggregation's, over
-- the batch at once: integer, text and NULL keys, two keys, a frozen table's
-- batch groups -- a text's bytes where its batch holds them, offsets or
-- views; batches of two keys a row at a time; off, as F26.  The counts the
-- leader's, alone
CREATE TABLE aok AS
  SELECT g / 5000 AS u, 'k' || (g / 7000) AS s, CASE WHEN g / 6000 % 3 = 0 THEN NULL ELSE g / 6000 END AS n,
         g AS x, (g % 1000)::int2 AS y, 'v' || (g / 5000) AS v
  FROM generate_series(1, 100000) g;
ANALYZE aok;
