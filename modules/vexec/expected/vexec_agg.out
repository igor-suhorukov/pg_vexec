(1 row)

-- W43 (pg_vector_executor.md §3.35): to_timestamp() of a float8 -- an
-- integer's seconds through its cast -- and a timestamptz's fields and
-- truncation under UTC, as kernels: the same rows, an infinity the
-- timestamp's, its errors PostgreSQL's; under another time zone the
-- timestamptz's bind no kernel
CREATE TABLE au (s int8, f float8);
INSERT INTO au VALUES (0, 0), (1373811234, 1373811234.5), (-1, -0.0000005), (NULL, NULL),
  (946684800, 'infinity'), (9007199254, '-infinity'), (2147483647, 1e10), (-62135596800, 253402300799.999999);
CREATE TABLE au_bad (f float8);
INSERT INTO au_bad VALUES (1), ('NaN');
SET TimeZone = 'UTC';
EXPLAIN (COSTS OFF, VERBOSE) SELECT date_trunc('minute', to_timestamp(s)), extract(hour FROM to_timestamp(s)) FROM au;
                                                            QUERY PLAN                                                             
-----------------------------------------------------------------------------------------------------------------------------------
 Vec Seq Scan on public.au
   Output: date_trunc('minute'::text, to_timestamp((s)::double precision)), EXTRACT(hour FROM to_timestamp((s)::double precision))
   Batch Format: postgres
   Kernel Steps: 6
   Fallback Steps: 0
   Shared Steps: 1
   Source: heap's pages
(7 rows)

SELECT agg_check($$SELECT to_timestamp(s), to_timestamp(f), date_trunc('minute', to_timestamp(s)),
       date_trunc('day', to_timestamp(f)), extract(hour FROM to_timestamp(s)), extract(epoch FROM to_timestamp(s)),
       extract(dow FROM to_timestamp(f)), count(*) FROM au GROUP BY 1, 2, 3, 4, 5, 6, 7$$);
  agg_check   
--------------
 same, VecAgg
(1 row)

SELECT agg_error('SELECT max(to_timestamp(f)) FROM au_bad');
                 agg_error                 
-------------------------------------------
 both ERROR 22008: timestamp cannot be NaN
(1 row)

SELECT agg_error('SELECT max(to_timestamp(f * 1e300)) FROM au_bad WHERE f = 1');
                     agg_error                      
----------------------------------------------------
 both ERROR 22008: timestamp out of range: "1e+300"
(1 row)

SET TimeZone = 'Europe/Moscow';
EXPLAIN (COSTS OFF, VERBOSE) SELECT date_trunc('minute', to_timestamp(s)), extract(hour FROM to_timestamp(s)) FROM au;
                                                            QUERY PLAN                                                             
-----------------------------------------------------------------------------------------------------------------------------------
 Vec Seq Scan on public.au
   Output: date_trunc('minute'::text, to_timestamp((s)::double precision)), EXTRACT(hour FROM to_timestamp((s)::double precision))
   Batch Format: postgres
   Kernel Steps: 0
   Fallback Steps: 0
   Row-by-Row Targets: 2
   Source: heap's pages
(7 rows)

SELECT agg_check($$SELECT date_trunc('hour', to_timestamp(s)), extract(hour FROM to_timestamp(s)), count(*)
       FROM au GROUP BY 1, 2$$);
  agg_check   
--------------
 same, VecAgg
(1 row)

RESET TimeZone;
DROP TABLE au, au_bad;
-- int8 sums past int64, as int128 holds them
SELECT agg_check($$SELECT sum(x), avg(x) FROM (VALUES (9223372036854775807::int8),
