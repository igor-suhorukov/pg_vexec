-- F16 (pg_vector_executor.md §3.37): the thawed table freezes again, for
-- good, at 8 times the bounds it froze at -- 800 groups here -- and a first
-- stage spills nothing: one that fills its memory freezes then, for good
-- (the first stage's lines alone, by their indent)
SELECT agg_explain('SELECT k, count(*), sum(n) FROM ah GROUP BY k', '^ {20}(Table|Spill|Groups Handed)');
                        agg_explain                         
------------------------------------------------------------
                     Table Frozen At: N groups
                     Groups Handed On: N
                     Table Thawed After: N groups handed on
                     Table Frozen Again At: N groups
(4 rows)

SET work_mem = '64kB';
SET hash_mem_multiplier = 1;
-- four workers planned, none launched: at 64 kB two make the parallel plan
-- cheaper by 2% only, four by 40%
SET max_parallel_workers_per_gather = 4;
SELECT agg_explain('SELECT k, count(*), sum(n) FROM ah GROUP BY k', '^ {20}(Table|Spill|Groups Handed)');
                  agg_explain                  
-----------------------------------------------
                     Table Frozen At: N groups
                     Groups Handed On: N
(2 rows)

SELECT agg_check('SELECT k, count(*), sum(id), sum(n), max(t), min(d) FROM ah GROUP BY k');
  agg_check   
--------------
 same, VecAgg
(1 row)

SET max_parallel_workers_per_gather = 2;
RESET hash_mem_multiplier;
RESET work_mem;
RESET max_parallel_workers;
RESET vexec.partial_agg_limit;
-- D2: a first stage whose every state is one of vexec's own without a
-- pointer packs its groups into the partitions, and the final stage merges
-- them as they lie: counts, integer sums and averages, int8's sums, min and
-- max of by-value types, bool_and and bool_or; keys of bits, bytes and the
-- type's functions, NULL keys, the first row's columns, compressed text
-- among them; in shared memory, or past vexec.repartition_shared_memory in
-- files; a frozen table's batch groups made packed, or, where its rows are
-- groups of their own, each row one with no lookup (the bypass); either
-- stage spilling; no worker; rescanned.  Not where a state holds a pointer
-- the group cannot take: sum(n).  A text's minimum and maximum (F5 of
-- §3.28) are packed by their values' bytes, each group by a copy, never
-- made where it is handed on: a frozen table's batch groups packed as the
-- batch ends, and no bypass
CREATE TABLE ap (id int PRIMARY KEY, k int, t text, big text, n numeric, d date);
INSERT INTO ap
  SELECT g, (g::int8 * 7919 % 30000)::int, CASE WHEN g % 7 = 0 THEN NULL ELSE 'v' || (g % 9000) END,
         repeat(md5((g % 500)::text), 80), (g % 97)::numeric / 8, date '2020-01-01' + (g % 365)
  FROM generate_series(1, 200000) g;
-- big's values, too wide for ANALYZE to count, are 500
ALTER TABLE ap ALTER COLUMN big SET (n_distinct = 500);
CREATE TABLE apk (id int PRIMARY KEY, big text, t text);
INSERT INTO apk
  SELECT g, repeat(md5(g::text), 80), CASE WHEN g % 9 = 0 THEN NULL ELSE 'w' || g END
  FROM generate_series(1, 5000) g;
ANALYZE ap, apk;
SET cpu_operator_cost = 0.25;
SELECT agg_explain($$SELECT k, count(*), sum(id), avg((id % 1000)::int2), sum(id::int8), max(d)
       FROM ap GROUP BY k$$, 'Input|Partition Format');
                  agg_explain                  
-----------------------------------------------
         Input: packed groups
               Input: batches
               Partition Format: packed groups
                     Input: batches
(4 rows)

SELECT agg_explain('SELECT k, count(*), sum(n) FROM ap GROUP BY k', 'Partition Format');
              agg_explain               
----------------------------------------
               Partition Format: frames
(1 row)

SELECT agg_explain('SELECT k, count(*), min(t) FROM ap GROUP BY k', 'Partition Format');
                  agg_explain                  
-----------------------------------------------
               Partition Format: packed groups
(1 row)

-- F14 (§3.32): a numeric key packed as its scaled integer
SELECT agg_explain('SELECT n, k % 50, count(*), sum(id) FROM ap GROUP BY 1, 2', 'Partition Format');
                  agg_explain                  
-----------------------------------------------
               Partition Format: packed groups
(1 row)

SELECT agg_explain($$SELECT s.id, s.big, s.t, count(*), sum(a.k) FROM ap a JOIN apk s ON s.id = a.id % 5000
       GROUP BY s.id$$, 'Repartition|Partition Format');
                          agg_explain                           
----------------------------------------------------------------
         ->  Parallel Vec Repartition (actual rows=N.N loops=N)
               Partition Format: packed groups
(2 rows)

CREATE FUNCTION agg_packed() RETURNS SETOF text LANGUAGE sql AS $f$
SELECT agg_check($$SELECT k, count(*), count(t), sum(id), avg((id % 1000)::int2), sum(id::int8),
       avg(id::int8), min(id), max(d), bool_and(id > 5), bool_or(id % 1000 = 0) FROM ap GROUP BY k$$)
UNION ALL
SELECT agg_check('SELECT t, k % 5, count(*), sum(id) FROM ap GROUP BY 1, 2')
UNION ALL
