-- F32 (§3.38): a batch's rows cut into runs of one key before any row is
-- hashed -- integers of each width, F10's scaled numerics, text as offsets and
-- as views, short and past a view's inlined bytes, NULLs, two keys -- each run's
-- first row alone hashed and looked up, a count(*) added by the run's length;
-- rows a qual filtered, C5's bound, a table spilling; off, as F30 and F26.  The
-- counts the leader's, alone: a run's first row and its repeats are the rows
CREATE TABLE ar AS
  SELECT g / 4 AS u, (g / 4)::int8 AS b, (g / 4 % 30000)::int2 AS h,
         CASE WHEN g % 50 < 8 THEN NULL ELSE 's' || (g / 8) END AS s,
         'a key past a view''s inlined bytes ' || (g / 16) AS l,
         timestamp '2020-01-01' + (g / 400) * interval '1 minute' AS ts,
         g AS x, (g % 1000)::int2 AS y
  FROM generate_series(1, 100000) g;
ANALYZE ar;
SET max_parallel_workers = 0;
-- (the first batch's rows the array's decision's, X5's: 1,025 looked up by no run)
SELECT agg_figure('SELECT u, count(*) FROM ar GROUP BY u', 'Key Runs') + 1025 +
       agg_figure('SELECT u, count(*) FROM ar GROUP BY u', 'Rows Taking the Row Before''s Group') AS every_row,
       agg_figure('SELECT u, count(*) FROM ar GROUP BY u', 'Key Runs') + 1025 AS one_run_a_key;
