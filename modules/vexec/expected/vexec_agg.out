(1 row)

-- expressions over keys and aggregates, HAVING, the first row's columns
SELECT agg_check('SELECT k + 1, sum(id) * 2, avg(f) + max(f) FROM at GROUP BY k HAVING count(*) > 10');
  agg_check   
--------------
 same, VecAgg
(1 row)

SELECT agg_check('SELECT k % 3, count(*) FROM at GROUP BY k % 3 HAVING sum(id) > 0');
  agg_check   
--------------
 same, VecAgg
(1 row)

SELECT agg_check('SELECT id, k, t, count(*) FROM at WHERE id < 100 GROUP BY id');
  agg_check   
--------------
 same, VecAgg
(1 row)

SELECT agg_check('SELECT count(*) FROM at HAVING count(*) > 1');
  agg_check   
--------------
 same, VecAgg
(1 row)

SELECT agg_check('SELECT count(*) FROM at HAVING count(*) < 1');
  agg_check   
--------------
 same, VecAgg
(1 row)

SELECT agg_check('SELECT 1 FROM at HAVING sum(k) > 0');
  agg_check   
--------------
 same, VecAgg
(1 row)

-- M3 (§3.21): a key that is an immutable expression of other keys --
-- columns compared by identity: integers, dates, timestamps, text under a
-- deterministic collation -- makes no group the others do not, and is left
-- out of the hash's keys; the output computes it from them, NULLs and all,
-- HAVING and ORDER BY too.  Kept: a key over a column compared otherwise --
-- a float, a numeric -- or over no other key, or a volatile one
SELECT agg_check('SELECT k, k - 1, k - 2, k - 3, count(*) FROM at GROUP BY 1, 2, 3, 4');
  agg_check   
--------------
 same, VecAgg
(1 row)

SELECT agg_check('SELECT s, s::int8 * 2, b, b / 1000, count(*), sum(id) FROM at GROUP BY 1, 2, 3, 4');
  agg_check   
--------------
 same, VecAgg
(1 row)

SELECT agg_check($$SELECT d, extract(year FROM d), ts, date_trunc('day', ts), count(*) FROM at GROUP BY 1, 2, 3, 4$$);
  agg_check   
--------------
 same, VecAgg
(1 row)

SELECT agg_check($$SELECT t, length(t), upper(t), t || 'x', coalesce(t, 'none'), count(*), min(id) FROM at GROUP BY 1, 2, 3, 4, 5$$);
  agg_check   
--------------
 same, VecAgg
(1 row)

SELECT agg_check('SELECT k, s, k + s, k * s, count(*) FROM at GROUP BY k, s, k + s, k * s');
  agg_check   
--------------
 same, VecAgg
(1 row)

SELECT agg_check('SELECT k, k * 2 AS k2, count(*) FROM at GROUP BY 1, 2 HAVING k * 2 > 6 ORDER BY k2 DESC');
  agg_check   
--------------
 same, VecAgg
(1 row)

SELECT agg_check('SELECT k + 1, k + 2, count(*) FROM at GROUP BY 1, 2');
  agg_check   
--------------
 same, VecAgg
(1 row)

SELECT agg_check('SELECT f, f * 2, n, n * 2, count(*) FROM at GROUP BY 1, 2, 3, 4');
  agg_check   
--------------
 same, VecAgg
(1 row)

SELECT agg_check('SELECT k, k + (random() * 0)::int, count(*) FROM at GROUP BY 1, 2');
  agg_check   
--------------
 same, VecAgg
(1 row)

SELECT agg_explain('SELECT k, k - 1, k - 2, count(*) FROM at GROUP BY 1, 2, 3', 'Group Key|Vec [A-Za-z ]*Aggregate');
                 agg_explain                 
---------------------------------------------
 Vec HashAggregate (actual rows=N.N loops=N)
   Group Key: at.k
(2 rows)

SELECT agg_explain('SELECT f, f * 2, count(*) FROM at GROUP BY 1, 2', 'Group Key|Vec [A-Za-z ]*Aggregate');
                     agg_explain                     
-----------------------------------------------------
 Vec HashAggregate (actual rows=N.N loops=N)
   Group Key: at.f, ((at.f * 'N'::double precision))
(2 rows)

SET vexec.drop_implied_keys = off;
SELECT agg_explain('SELECT k, k - 1, k - 2, count(*) FROM at GROUP BY 1, 2, 3', 'Group Key');
                  agg_explain                  
-----------------------------------------------
   Group Key: at.k, ((at.k - N)), ((at.k - N))
(1 row)

RESET vexec.drop_implied_keys;
-- F22 (§3.38): the keys M3 leaves out of the hash's, out of the vector
-- scan below too, which then computes none of them -- the aggregation's
-- output computes them from k; with vexec.drop_implied_key_inputs off, and
-- where M3 keeps the keys, the scan computes them as before
SELECT agg_explain('SELECT k, k - 1, k - 2, count(*) FROM at GROUP BY 1, 2, 3', 'Vec Seq Scan|Output');
                        agg_explain                        
-----------------------------------------------------------
   Output: k, (k - N), (k - N), (count(*))
   ->  Vec Seq Scan on public.at (actual rows=N.N loops=N)
         Output: k
(3 rows)

SELECT agg_check('SELECT k - 2, k, sum(k - 1), count(*) FROM at GROUP BY 1, 2 HAVING max(k - 2) >= 0');
  agg_check   
--------------
 same, VecAgg
(1 row)

SET vexec.drop_implied_key_inputs = off;
SELECT agg_explain('SELECT k, k - 1, k - 2, count(*) FROM at GROUP BY 1, 2, 3', 'Vec Seq Scan|Output');
                        agg_explain                        
-----------------------------------------------------------
   Output: k, (k - N), (k - N), (count(*))
   ->  Vec Seq Scan on public.at (actual rows=N.N loops=N)
         Output: k, (k - N), (k - N)
(3 rows)

RESET vexec.drop_implied_key_inputs;
SET vexec.drop_implied_keys = off;
SELECT agg_explain('SELECT k, k - 1, k - 2, count(*) FROM at GROUP BY 1, 2, 3', 'Vec Seq Scan|Output');
                        agg_explain                        
-----------------------------------------------------------
   Output: k, ((k - N)), ((k - N)), (count(*))
   ->  Vec Seq Scan on public.at (actual rows=N.N loops=N)
         Output: k, (k - N), (k - N)
(3 rows)

RESET vexec.drop_implied_keys;
-- F20 (§3.38): in auto mode, a grouping of fewer input rows than
-- vexec.min_rows by the estimate is VecAgg's where it reads a vector
-- scan's batches; over rows -- a function's here -- PostgreSQL's as before,
-- and with vexec.enable_agg_below_min_rows off
SET vexec.mode = auto;
EXPLAIN (COSTS OFF) SELECT k, count(*), sum(id) FROM at WHERE b < 300000 GROUP BY k;
          QUERY PLAN          
------------------------------
 Vec HashAggregate
   Group Key: k
   ->  Vec Seq Scan on at
         Filter: (b < 300000)
(4 rows)

SET vexec.enable_agg_below_min_rows = off;
EXPLAIN (COSTS OFF) SELECT k, count(*), sum(id) FROM at WHERE b < 300000 GROUP BY k;
          QUERY PLAN          
------------------------------
 HashAggregate
   Group Key: k
   ->  Vec Seq Scan on at
         Filter: (b < 300000)
(4 rows)

RESET vexec.enable_agg_below_min_rows;
EXPLAIN (COSTS OFF) SELECT x % 3, count(*) FROM generate_series(1, 300) x GROUP BY 1;
                QUERY PLAN                
------------------------------------------
 HashAggregate
   Group Key: (x % 3)
   ->  Function Scan on generate_series x
(3 rows)

SET vexec.mode = force;
-- no rows: a plain aggregation's one row, a hashed one's none
SELECT agg_check('SELECT count(*), sum(id), avg(n), min(t), bool_and(bo), sum(f), variance(r) FROM ae');
  agg_check   
--------------
 same, VecAgg
(1 row)

SELECT agg_check('SELECT k, count(*) FROM ae GROUP BY k');
  agg_check   
--------------
