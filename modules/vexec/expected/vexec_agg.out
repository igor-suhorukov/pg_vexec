  agg_check   
--------------
 same, VecAgg
(1 row)

SELECT agg_explain('SELECT id, count(*), sum(n) FROM at GROUP BY id', 'Spill|Vec');
                        agg_explain                        
-----------------------------------------------------------
 Vec HashAggregate (actual rows=N.N loops=N)
   Vector Transitions: N of N
   Spilled Partitions: N
   Spilled Rows: N
   Spill Depth: N
   ->  Vec Seq Scan on public.at (actual rows=N.N loops=N)
(6 rows)

RESET work_mem;
RESET hash_mem_multiplier;
RESET enable_sort;
-- the partial and final pair, under a Gather.  Which rows each worker
-- sums is the workers' race: a float's sum is compared to 10 digits.
SET parallel_setup_cost = 0;
SET parallel_tuple_cost = 0;
SET min_parallel_table_scan_size = 0;
SET max_parallel_workers_per_gather = 2;
EXPLAIN (COSTS OFF) SELECT k, count(*), sum(n), avg(f) FROM at GROUP BY k;
                  QUERY PLAN                   
-----------------------------------------------
 Vec Finalize HashAggregate
   Group Key: k
   ->  Gather
         Workers Planned: 2
         ->  Vec Partial HashAggregate
               Group Key: k
               ->  Parallel Vec Seq Scan on at
(7 rows)

