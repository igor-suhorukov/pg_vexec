RESET parallel_tuple_cost;
RESET min_parallel_table_scan_size;
RESET max_parallel_workers_per_gather;
-- F10 (§3.31): extract()'s fields within the day from the time of day --
-- before 2000 and after, an infinity's NULL, date_part()'s floats -- and a
-- numeric key of a batch's scaled integers hashed and compared by them, a
-- group's numeric made once: extract()'s, a numeric(10,3) column's; one value
-- at two display scales, 5 and 5.000000, one group, as numeric_eq() makes it
CREATE TABLE af AS
  SELECT g AS id, timestamp '1999-12-31 22:00' + g * interval '7.123457 seconds' AS ts,
         (g % 37)::numeric(10,3) / 8 AS n3
  FROM generate_series(1, 30000) g
  UNION ALL SELECT 0, 'infinity', NULL
  UNION ALL SELECT -1, '-infinity', 0;
ANALYZE af;
EXPLAIN (COSTS OFF, VERBOSE) SELECT extract(minute FROM ts), count(*) FROM af GROUP BY 1;
                   QUERY PLAN                    
-------------------------------------------------
 Vec HashAggregate
   Output: (EXTRACT(minute FROM ts)), (count(*))
   Group Key: (EXTRACT(minute FROM af.ts))
   Batch Format: postgres
   Vector Transitions: 1 of 1
   Transitions: count(*)
   Kernel Steps: 0
   Fallback Steps: 0
   Input: batches
   ->  Vec Seq Scan on public.af
         Output: EXTRACT(minute FROM ts)
         Batch Format: postgres
         Kernel Steps: 1
         Fallback Steps: 0
         Source: heap's pages
(15 rows)

SELECT agg_check($$SELECT extract(hour FROM ts), extract(minute FROM ts), count(*), sum(id) FROM af GROUP BY 1, 2$$);
  agg_check   
--------------
 same, VecAgg
(1 row)

