(1 row)

RESET max_parallel_workers;
-- the plan run serially, as a SQL function's last query runs a row at a
-- time (functions.c): no DSM, and the node passes its child's groups on.
-- The function's plan is cached at its first call, in force mode.
CREATE FUNCTION ah_total() RETURNS numeric LANGUAGE sql
  AS 'SELECT sum(c * s) FROM (SELECT k, count(*) c, sum(n) s FROM ah GROUP BY k) x';
EXPLAIN (COSTS OFF) SELECT sum(c * s) FROM (SELECT k, count(*) c, sum(n) s FROM ah GROUP BY k) x;
                              QUERY PLAN                               
-----------------------------------------------------------------------
 Vec Finalize Aggregate
   ->  Gather
         Workers Planned: 2
         ->  Vec Partial Aggregate
               ->  Subquery Scan on x
                     ->  Vec Finalize HashAggregate
                           Group Key: k
                           ->  Parallel Vec Repartition
                                 Partition Key: k
                                 ->  Vec Partial HashAggregate
                                       Group Key: k
                                       ->  Parallel Vec Seq Scan on ah
(12 rows)

SELECT ah_total();
          ah_total           
-----------------------------
 539996.25000000000000000000
(1 row)

SET vexec.mode = off;
SELECT sum(c * s) FROM (SELECT k, count(*) c, sum(n) s FROM ah GROUP BY k) x;
             sum             
-----------------------------
 539996.25000000000000000000
(1 row)

SET vexec.mode = force;
DROP FUNCTION ah_total();
-- rescanned: the Gather a nested loop's inner, the partitions made again
SET enable_hashjoin = off;
SET enable_mergejoin = off;
SET enable_material = off;
SET enable_memoize = off;
EXPLAIN (COSTS OFF) WITH o AS MATERIALIZED (SELECT i FROM generate_series(0, 3) i)
SELECT o.i, count(x.k), sum(x.s) FROM o LEFT JOIN (SELECT k, count(*) c, sum(n) s FROM ah GROUP BY k) x
  ON x.c >= o.i + 2 GROUP BY o.i;
                              QUERY PLAN                               
-----------------------------------------------------------------------
 Vec HashAggregate
   Group Key: i
   CTE o
     ->  Function Scan on generate_series i
   ->  Nested Loop Left Join
         Join Filter: (x.c >= (o.i + 2))
         ->  CTE Scan on o
         ->  Gather
               Workers Planned: 2
               ->  Subquery Scan on x
                     ->  Vec Finalize HashAggregate
                           Group Key: k
                           ->  Parallel Vec Repartition
                                 Partition Key: k
                                 ->  Vec Partial HashAggregate
                                       Group Key: k
                                       ->  Parallel Vec Seq Scan on ah
(17 rows)

SELECT agg_check($$WITH o AS MATERIALIZED (SELECT i FROM generate_series(0, 3) i)
SELECT o.i, count(x.k), sum(x.s) FROM o LEFT JOIN (SELECT k, count(*) c, sum(n) s FROM ah GROUP BY k) x
  ON x.c >= o.i + 2 GROUP BY o.i$$);
  agg_check   
--------------
 same, VecAgg
(1 row)

RESET enable_hashjoin;
RESET enable_mergejoin;
RESET enable_material;
RESET enable_memoize;
-- C1: the final stage combines the partial states by kernels -- counts,
-- integer sums, avg's arrays, int8's serialized sums, min, max, bool_and
-- -- floats' and numerics' through fmgr
SELECT agg_explain($$SELECT k, count(*), sum(id::int4), avg((id % 100)::int2), avg(id::int8), max(d), bool_or(id > 3)
       FROM ah GROUP BY k$$, 'Aggregate|Transitions:');
                                                 agg_explain                                                  
--------------------------------------------------------------------------------------------------------------
   ->  Vec Finalize HashAggregate (actual rows=N.N loops=N)
         Vector Transitions: N of N
         Transitions: combine count, combine sum, combine avg, combine intN sum, combine max, combine bool_or
               ->  Vec Partial HashAggregate (actual rows=N.N loops=N)
                     Vector Transitions: N of N
                     Transitions: count(*), sum, avg, intN sum, max, bool_or
(6 rows)

SELECT agg_check($$SELECT k % 7, count(*), count(n), sum(id::int4), avg((id % 100)::int2), sum(id::int8),
       avg(id::int8), min(t), max(d), min(id), bool_and(id > 3), bool_or(id > 119990), sum(n), max(k)
       FROM ah GROUP BY 1$$);
  agg_check   
--------------
 same, VecAgg
(1 row)

